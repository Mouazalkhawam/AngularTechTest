@{
    Layout = null;
}

<!DOCTYPE html>
<html ng-app="MyApp">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Employees Management</title>

  
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .table-hover tbody tr:hover {
            background-color: #f5f5f5;
            cursor: pointer;
        }

        .total-row {
            font-weight: bold;
            background-color: #e8f4f8;
        }

        .modal-body input {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .pagination {
            margin: 20px 0;
        }

            .pagination li.active a {
                background-color: #337ab7;
                border-color: #337ab7;
            }
    </style>
</head>
<body ng-controller="EmpCtrl">
    <div class="container">
        <h2>Employees Management</h2>

        <div ng-if="!employees || employees.length === 0" class="alert alert-info text-center">
            <strong>Loading employees data...</strong>
        </div>

      
        <table class="table table-striped table-hover" ng-if="employees.length > 0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Salary ($)</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="employee in employees | itemsPerPage: pageSize"
                    ng-click="openModal(employee)">
                    <td>{{employee.Id}}</td>
                    <td>{{employee.Name}}</td>
                    <td>{{employee.Department}}</td>
                    <td>{{employee.Salary | number:0}}</td>
                </tr>
                <tr class="total-row">
                    <td colspan="3" style="text-align: right;"><strong>Total Salaries:</strong></td>
                    <td><strong>{{getTotalSalary() | number:0}}</strong></td>
                </tr>
            </tbody>
        </table>

       
        <div class="text-center" ng-if="employees.length > pageSize">
            <dir-pagination-controls max-size="5"
                                     direction-links="true"
                                     boundary-links="true"
                                     auto-hide="false">
            </dir-pagination-controls>
            <div class="text-muted">
                Page {{currentPage}} of {{getNumberOfPages()}} (Total: {{employees.length}} employees)
            </div>
        </div>
    </div>

    
    <div id="employeeModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Edit Employee Salary</h4>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label>ID:</label>
                            <p class="form-control-static">{{selectedEmployee.Id}}</p>
                        </div>
                        <div class="form-group">
                            <label>Name:</label>
                            <p class="form-control-static">{{selectedEmployee.Name}}</p>
                        </div>
                        <div class="form-group">
                            <label>Department:</label>
                            <p class="form-control-static">{{selectedEmployee.Department}}</p>
                        </div>
                        <div class="form-group">
                            <label>Salary ($):</label>
                            <input type="number"
                                   ng-model="editedSalary"
                                   class="form-control"
                                   min="0"
                                   step="1000" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" ng-click="saveSalary()">Save</button>
                </div>
            </div>
        </div>
    </div>

   
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script src="~/Scripts/angularUtils/pagination/dirPagination.js"></script>

    <script>
        angular.module('MyApp', ['angularUtils.directives.dirPagination'])
            .controller('EmpCtrl', function ($scope, $http, $timeout) {

                $scope.employees = [];
                $scope.pageSize = 5;
                $scope.currentPage = 1;

          
                $scope.loadEmployees = function () {
                    $http.get('/Employees/GetEmployees')
                        .then(function (response) {
                            $scope.employees = response.data;
                            console.log('✅ Employees loaded:', $scope.employees.length);
                        });
                };

              
                $scope.getNumberOfPages = function () {
                    return Math.ceil($scope.employees.length / $scope.pageSize);
                };

               
                $scope.getTotalSalary = function () {
                    var total = 0;
                    angular.forEach($scope.employees, function (emp) {
                        total += emp.Salary || 0;
                    });
                    return total;
                };

                $scope.openModal = function (employee) {
                    $scope.selectedEmployee = {
                        Id: employee.Id,
                        Name: employee.Name,
                        Department: employee.Department,
                        Salary: employee.Salary
                    };
                    $scope.editedSalary = employee.Salary;

                    $timeout(function () {
                        $('#employeeModal').modal('show');
                    }, 50);
                };

        
                $scope.saveSalary = function () {
                    if (!$scope.selectedEmployee || !$scope.selectedEmployee.Id) {
                        alert('No employee selected');
                        return;
                    }

                    var newSalary = parseFloat($scope.editedSalary);

                    if (isNaN(newSalary) || newSalary <= 0) {
                        alert('Please enter a valid salary');
                        return;
                    }

                    $http({
                        method: 'POST',
                        url: '/Employees/UpdateSalary',
                        params: {
                            id: $scope.selectedEmployee.Id,
                            salary: newSalary
                        }
                    })
                        .then(function (response) {
                            if (response.data.success) {
                                var index = $scope.employees.findIndex(function (e) {
                                    return e.Id === $scope.selectedEmployee.Id;
                                });

                                if (index !== -1) {
                                    $scope.employees[index].Salary = newSalary;
                                }

                                $('#employeeModal').modal('hide');
                                alert('Salary updated successfully!');
                            }
                        })
                        .catch(function (error) {
                            console.error('Error:', error);
                            alert('Error updating salary');
                        });
                };

               
                $scope.loadEmployees();
            });
    </script>
</body>
</html>