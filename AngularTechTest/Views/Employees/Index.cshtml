@{
    Layout = null;
}

<!DOCTYPE html>
<html ng-app="MyApp">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Employees Management</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .table-hover tbody tr:hover {
            background-color: #f5f5f5;
        }

        .total-row {
            font-weight: bold;
            background-color: #e8f4f8;
        }

        .modal-body input {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .pagination {
            margin: 20px 0;
        }

            .pagination li.active a {
                background-color: #337ab7;
                border-color: #337ab7;
            }

        .spinner-border {
            display: inline-block;
            width: 1rem;
            height: 1rem;
            vertical-align: text-bottom;
            border: 0.2em solid currentColor;
            border-right-color: transparent;
            border-radius: 50%;
            animation: spin .75s linear infinite;
            margin-bottom: 3px;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .btn-tasks {
            margin-left: 5px;
            padding: 3px 8px;
            font-size: 12px;
        }

        .action-buttons {
            white-space: nowrap;
        }
    </style>
</head>
<body ng-controller="EmpCtrl">
    <div class="container">
        <h2>Employees Management</h2>

        <div ng-if="!employees || employees.length === 0" class="alert alert-info text-center">
            <strong>Loading employees data...</strong>
        </div>

        <table class="table table-striped table-hover" ng-if="employees.length > 0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Salary ($)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="employee in employees | itemsPerPage: pageSize">
                    <td>{{employee.Id}}</td>
                    <td>{{employee.Name}}</td>
                    <td>{{employee.Department}}</td>
                    <td>{{employee.Salary | number:0}}</td>
                    <td class="action-buttons">
                        <button class="btn btn-primary btn-tasks"
                                ng-click="openModal(employee)"
                                title="Edit Salary">
                            <span class="glyphicon glyphicon-pencil"></span> Edit
                        </button>
                        <button class="btn btn-info btn-tasks"
                                ng-click="openTasksModal(employee)"
                                title="View Tasks">
                            <span class="glyphicon glyphicon-tasks"></span> Tasks
                        </button>
                    </td>
                </tr>
                <tr class="total-row">
                    <td colspan="4" style="text-align: right;"><strong>Total Salaries:</strong></td>
                    <td><strong>{{getTotalSalary() | number:0}}</strong></td>
                </tr>
            </tbody>
        </table>

        <div class="text-center" ng-if="employees.length > pageSize">
            <dir-pagination-controls max-size="5"
                                     direction-links="true"
                                     boundary-links="true"
                                     auto-hide="false">
            </dir-pagination-controls>
            <div class="text-muted">
                Page {{currentPage}} of {{getNumberOfPages()}} (Total: {{employees.length}} employees)
            </div>
        </div>
    </div>

    <div id="employeeModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Edit Employee Salary</h4>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label>ID:</label>
                            <p class="form-control-static">{{selectedEmployee.Id}}</p>
                        </div>
                        <div class="form-group">
                            <label>Name:</label>
                            <p class="form-control-static">{{selectedEmployee.Name}}</p>
                        </div>
                        <div class="form-group">
                            <label>Department:</label>
                            <p class="form-control-static">{{selectedEmployee.Department}}</p>
                        </div>
                        <div class="form-group">
                            <label>Salary ($):</label>
                            <input type="number"
                                   ng-model="editedSalary"
                                   class="form-control"
                                   min="0"
                                   step="1" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button"
                            class="btn btn-primary"
                            ng-click="saveSalary()">
                        <span ng-if="!isSaving">Save</span>
                        <span ng-if="isSaving">
                            <span class="spinner-border"></span> Saving...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="tasksModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <span class="glyphicon glyphicon-tasks"></span>
                        Tasks for {{selectedEmployeeForTasks.Name}}
                    </h4>
                </div>
                <div class="modal-body">
                    <div ng-if="isLoadingTasks" class="text-center">
                        <span class="spinner-border"></span> Loading tasks...
                    </div>

                    <div ng-if="!isLoadingTasks && employeeTasks.length === 0" class="alert alert-info">
                        No tasks assigned to this employee.
                    </div>

                    <table class="table table-striped" ng-if="employeeTasks.length > 0">
                        <thead>
                            <tr>
                                <th>Task Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="task in employeeTasks">
                                <td>{{task.TaskName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script src="@Url.Content("~/Scripts/angularUtils/pagination/dirPagination.js")"></script>
    <script>
        angular.module('MyApp', ['angularUtils.directives.dirPagination']);
    </script>
    <script src="@Url.Content("~/Scripts/directives/loaderDirective.js")"></script>
    <script>
        angular.module('MyApp', ['angularUtils.directives.dirPagination'])
            .controller('EmpCtrl', function ($scope, $http, $timeout) {
                $scope.employees = [];
                $scope.pageSize = 5;
                $scope.currentPage = 1;
                $scope.selectedEmployee = null;
                $scope.editedSalary = 0;
                $scope.isSaving = false;
                $scope.employeeTasks = [];
                $scope.selectedEmployeeForTasks = null;
                $scope.isLoadingTasks = false;

                $scope.loadEmployees = function () {
                    $http.get('/Employees/GetEmployees')
                        .then(function (response) {
                            $scope.employees = response.data;
                        })
                        .catch(function (error) {
                            console.error('Error loading employees:', error);
                        });
                };

                $scope.getNumberOfPages = function () {
                    return Math.ceil($scope.employees.length / $scope.pageSize);
                };

                $scope.getTotalSalary = function () {
                    var total = 0;
                    angular.forEach($scope.employees, function (emp) {
                        total += emp.Salary || 0;
                    });
                    return total;
                };

                $scope.openModal = function (employee) {
                    $scope.selectedEmployee = {
                        Id: employee.Id,
                        Name: employee.Name,
                        Department: employee.Department,
                        Salary: employee.Salary
                    };
                    $scope.editedSalary = employee.Salary;
                    $timeout(function () {
                        $('#employeeModal').modal('show');
                    }, 50);
                };

                $scope.saveSalary = function () {
                    if (!$scope.selectedEmployee || !$scope.selectedEmployee.Id) {
                        alert('No employee selected');
                        return;
                    }

                    var salaryValue = $scope.editedSalary;

                    if (salaryValue === null || salaryValue === undefined || salaryValue === '') {
                        alert('Please enter a valid salary');
                        return;
                    }

                    var newSalary = Number(salaryValue);

                    if (isNaN(newSalary)) {
                        alert('Please enter a valid salary');
                        return;
                    }

                    if (newSalary <= 0) {
                        alert('Please enter a valid salary');
                        return;
                    }

                    $scope.isSaving = true;

                    return $http({
                        method: 'POST',
                        url: '/Employees/UpdateSalary',
                        params: {
                            id: $scope.selectedEmployee.Id,
                            salary: newSalary
                        }
                    })
                        .then(function (response) {
                            if (response.data.success) {
                                var index = $scope.employees.findIndex(function (e) {
                                    return e.Id === $scope.selectedEmployee.Id;
                                });

                                if (index !== -1) {
                                    $scope.employees[index].Salary = newSalary;
                                }

                                $('#employeeModal').modal('hide');
                                alert('Salary updated successfully!');
                            } else {
                                alert('Error: ' + response.data.message);
                            }
                        })
                        .catch(function (error) {
                            console.error('Error:', error);
                            alert('Error updating salary');
                        })
                        .finally(function () {
                            $scope.isSaving = false;
                        });
                };

                $scope.openTasksModal = function (employee) {
                    $scope.selectedEmployeeForTasks = employee;
                    $scope.employeeTasks = [];
                    $scope.isLoadingTasks = true;

                    $http.get('/Tasks/GetEmployeeTasks', {
                        params: { employeeId: employee.Id }
                    })
                        .then(function (response) {
                            if (response.data.success) {
                                $scope.employeeTasks = response.data.tasks;
                            } else {
                                alert('Error loading tasks: ' + response.data.message);
                            }
                        })
                        .catch(function (error) {
                            console.error('Error loading tasks:', error);
                            alert('Error loading tasks');
                        })
                        .finally(function () {
                            $scope.isLoadingTasks = false;
                            $timeout(function () {
                                $('#tasksModal').modal('show');
                            }, 50);
                        });
                };

                $scope.loadEmployees();
            });
    </script>
</body>
</html>